---
import '@/styles/global.css';
import PantallaVenta from '@/components/pos/PantallaVenta';
import BarraNav from '@/components/pos/BarraNav.astro';
import { obtenerSesionCajaActiva, obtenerUsuarioActual } from '@/lib/pos/sesionActual';
import { puedeVender } from '@/lib/permisos';

const usuario = await obtenerUsuarioActual(Astro.cookies);
if (!usuario) return Astro.redirect('/');
if (!puedeVender(usuario.rol)) return Astro.redirect('/pedidos');

// "Sin caja abierta no se puede vender" (§3.1).
const sesion = await obtenerSesionCajaActiva();
if (!sesion) return Astro.redirect('/caja/abrir');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>S&J POS — Vender</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="flex h-screen flex-col overflow-hidden">
    <BarraNav />
    <PantallaVenta client:load />
  </body>
</html>
