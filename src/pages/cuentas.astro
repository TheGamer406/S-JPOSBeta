---
import '@/styles/global.css';
import PantallaCuentas from '@/components/pos/PantallaCuentas';
import BarraNav from '@/components/pos/BarraNav.astro';
import { obtenerUsuarioActual } from '@/lib/pos/sesionActual';

const usuario = await obtenerUsuarioActual(Astro.cookies);
if (!usuario) return Astro.redirect('/');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>S&J POS — Cuentas</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <BarraNav />
    <PantallaCuentas client:load />
  </body>
</html>
