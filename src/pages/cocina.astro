---
import '@/styles/global.css';
import VistaCocina from '@/components/pos/VistaCocina';
import BarraNav from '@/components/pos/BarraNav.astro';
import { obtenerUsuarioActual } from '@/lib/pos/sesionActual';
import { puedeVerCola } from '@/lib/permisos';

const usuario = await obtenerUsuarioActual(Astro.cookies);
if (!usuario) return Astro.redirect('/');
if (!puedeVerCola(usuario.rol)) return Astro.redirect('/');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>S&J POS — Cocina</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <BarraNav rol={usuario.rol} />
    <VistaCocina client:load />
  </body>
</html>
