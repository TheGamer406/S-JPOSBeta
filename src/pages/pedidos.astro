---
import '@/styles/global.css';
import ColaPedidos from '@/components/pos/ColaPedidos';
import BarraNav from '@/components/pos/BarraNav.astro';
import { obtenerUsuarioActual } from '@/lib/pos/sesionActual';
import { puedeVerDinero } from '@/lib/permisos';

const usuario = await obtenerUsuarioActual(Astro.cookies);
if (!usuario) return Astro.redirect('/');
// Esta cola muestra montos y medios de pago — cocina no ve dinero (§2). Esa pantalla es /cocina.
if (!puedeVerDinero(usuario.rol)) return Astro.redirect('/cocina');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>S&J POS — Pedidos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <BarraNav rol={usuario.rol} />
    <ColaPedidos client:load />
  </body>
</html>
