---
import '@/styles/global.css';
import FormularioAperturaCaja from '@/components/pos/FormularioAperturaCaja';
import { obtenerSesionCajaActiva, obtenerUsuarioActual } from '@/lib/pos/sesionActual';
import { puedeVerDinero, esAdmin } from '@/lib/permisos';

const usuario = await obtenerUsuarioActual(Astro.cookies);
if (!usuario) return Astro.redirect('/');
if (!puedeVerDinero(usuario.rol)) return Astro.redirect('/cocina');

const sesionActiva = await obtenerSesionCajaActiva();
if (sesionActiva) return Astro.redirect('/vender');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>S&J POS — Abrir caja</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center gap-6 p-4">
    <h1 class="marca text-3xl">Apertura de caja</h1>
    {esAdmin(usuario.rol) ? (
      <>
        <p class="text-[var(--text_color_2)]">Hola, {usuario.nombre} — antes de vender hay que abrir la caja.</p>
        <FormularioAperturaCaja client:load />
      </>
    ) : (
      <p class="max-w-sm text-center text-[var(--text_color_2)]">
        Hola, {usuario.nombre} — hace falta que un admin abra la caja antes de poder vender.
      </p>
    )}
  </body>
</html>
