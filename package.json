{
  "name": "sj-pos",
  "version": "0.1.0",
  "description": "POS de escritorio para S&J Parrilladas y Catering Service",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"astro dev\" \"wait-on http://localhost:4321 && electron .\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx seed/seed.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/preact": "^4.0.0",
    "astro": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "node-thermal-printer": "^4.4.4",
    "pdfkit": "^0.20.2",
    "preact": "^10.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.28.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
